@* House-style page header: kicker names the section, title names the action *@
<div class="d-flex flex-wrap align-center justify-space-between gap-4 mb-6">
    <div>
        @if (!string.IsNullOrEmpty(Kicker))
        {
            <MudText Typo="Typo.overline" Class="mud-text-secondary">@Kicker</MudText>
        }
        <MudText Typo="Typo.h4">@Title</MudText>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Subtitle</MudText>
        }
    </div>
    @if (Actions != null)
    {
        <div class="d-flex align-center gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Kicker { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
